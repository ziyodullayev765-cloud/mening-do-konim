# PostgreSQL connection string (pooled is fine)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL if you have no pooler.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Initial admin account (used only by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-long-random-password"

# Public URL of the site (used for SEO: sitemap, canonical, Open Graph)
SITE_URL="https://example.com"
